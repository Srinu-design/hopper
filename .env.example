# Copy to .env (cp .env.example .env). Environment variables only; never commit .env.
POSTGRES_USER=hopper
POSTGRES_PASSWORD=hopper
POSTGRES_DB=hopper
# Host ports (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Used by the host (tests, alembic) and by the containers, which override the host name.
DATABASE_URL=postgresql+asyncpg://hopper:hopper@127.0.0.1:5432/hopper
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO

# API secrets. The API refuses to start without them. These values are for local
# development only; for anything else generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=dev-only-pepper-change-me
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# JWT_TTL_SECONDS=900            # admin tokens last 15 minutes
# API_KEY_CACHE_SECONDS=60       # a revoked key keeps working on other replicas up to this long

# Worker (defaults shown)
# WORKER_QUEUES=default          # comma separated, claimed in this order
# WORKER_SLOTS=20                # max jobs one worker runs at once
# WORKER_POLL_INTERVAL=0.25      # seconds between polls when work was found
# WORKER_MAX_IDLE_BACKOFF=0.5    # idle polling backs off up to this many seconds
# LEASE_SECONDS=30               # a crashed worker's job is requeued after lease + reaper interval
# HEARTBEAT_SECONDS=10           # renew all in-flight leases this often; must be < LEASE_SECONDS
# SHUTDOWN_GRACE_SECONDS=25      # on SIGTERM, wait this long, then release unfinished jobs
# HTTP_ALLOW_PRIVATE_NETWORKS=false  # true lets http jobs call private addresses: local demos only
# HTTP_CONNECT_TIMEOUT=5
# HTTP_READ_TIMEOUT=10

# Scheduler (defaults shown)
# REAPER_INTERVAL_SECONDS=5
# REAPER_BATCH_SIZE=500
# CRON_INTERVAL_SECONDS=1
# CRON_BATCH_SIZE=100
