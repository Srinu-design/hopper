# Copy to .env (cp .env.example .env). Environment variables only; never commit .env.
POSTGRES_USER=hopper
POSTGRES_PASSWORD=hopper
POSTGRES_DB=hopper
# Host ports (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Grafana's admin login (user admin). Viewers need no login. Development value only.
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-change-me

# Used by the host (tests, alembic) and by the containers, which override the host name.
DATABASE_URL=postgresql+asyncpg://hopper:hopper@127.0.0.1:5432/hopper
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
# DB_POOL_SIZE=5                 # connections per process; keep processes x pool under Postgres's 100
# DB_MAX_OVERFLOW=0              # extra connections a busy process may open beyond the pool

# API secrets. The API refuses to start without them. These values are for local
# development only; for anything else generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=dev-only-pepper-change-me
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# JWT_TTL_SECONDS=900            # admin tokens last 15 minutes
# JWT_ISSUER=hopper              # the iss and aud claims an admin token must carry
# JWT_AUDIENCE=hopper-admin
# API_KEY_CACHE_SECONDS=60       # a revoked key keeps working on other replicas up to this long

# Worker (defaults shown)
# WORKER_QUEUES=default          # comma separated, claimed in this order
# WORKER_SLOTS=20                # max jobs one worker runs at once
# WORKER_POLL_INTERVAL=0.25      # seconds between polls when work was found
# WORKER_MAX_IDLE_BACKOFF=0.5    # idle polling backs off up to this many seconds
# LEASE_SECONDS=30               # a crashed worker's job is requeued after lease + reaper interval
# HEARTBEAT_SECONDS=10           # renew all in-flight leases this often; must be < LEASE_SECONDS
# SHUTDOWN_GRACE_SECONDS=25      # on SIGTERM, wait this long, then release unfinished jobs
# HTTP_ALLOW_PRIVATE_NETWORKS=false  # true lets http jobs call private addresses: local demos only
# HTTP_CONNECT_TIMEOUT=5
# HTTP_READ_TIMEOUT=10

# Scheduler (defaults shown)
# REAPER_INTERVAL_SECONDS=5
# REAPER_BATCH_SIZE=500
# CRON_INTERVAL_SECONDS=1
# CRON_BATCH_SIZE=100
# DEPTH_INTERVAL_SECONDS=1       # count queue depth for metrics and backpressure

# Limits (defaults shown). Each tenant's rate, burst and queue quota are set per tenant.
# GLOBAL_MAX_QUEUE_DEPTH=1000000         # queued jobs, all tenants, before enqueues get 503
# BACKPRESSURE_RETRY_AFTER_SECONDS=5     # Retry-After on a quota 429 or an overload 503
# REDIS_TIMEOUT_SECONDS=0.25             # a slow Redis costs a request at most this long
# REDIS_MAX_CONNECTIONS=50               # per process; a burst beyond it waits for one
# REDIS_RETRY_SECONDS=5                  # after a Redis error, limit in process this long
# REDIS_NAMESPACE=hopper                 # prefix for every Redis key

# Metrics: every process serves Prometheus metrics on this internal port (0 = off)
# METRICS_PORT=9100

# Deploys: while this file exists, /readyz answers 503 "draining" so the load balancer stops
# sending the replica requests before deploy.sh replaces it (ADR-0011)
# DRAIN_FILE=/tmp/hopper-draining
