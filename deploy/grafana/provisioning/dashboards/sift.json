{
 "uid": "sift",
 "title": "Sift",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "sift"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "p95 latency per stage",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(sift_query_seconds_bucket[5m])))",
     "legendFormat": "{{stage}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p50 latency per stage",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(sift_query_seconds_bucket[5m])))",
     "legendFormat": "{{stage}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queries per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (strategy) (rate(sift_queries_total[1m]))",
     "legendFormat": "{{strategy}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Cost per query (USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(sift_query_cost_usd_total[5m])) / sum(rate(sift_queries_total[5m]))",
     "legendFormat": "cost"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Cache hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (layer) (rate(sift_cache_hits_total[5m])) / sum by (layer) (rate(sift_cache_lookups_total[5m]))",
     "legendFormat": "{{layer}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Refusals by gate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gate) (rate(sift_refusals_total[5m]))",
     "legendFormat": "{{gate}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Errors and rejections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (status) (rate(sift_http_responses_total{status=~\"4xx|5xx\"}[5m]))",
     "legendFormat": "{{status}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(sift_budget_rejections_total[5m]))",
     "legendFormat": "budget 429"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "LLM tokens per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (direction) (rate(sift_llm_tokens_total[5m]))",
     "legendFormat": "{{direction}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Ingestion backlog (Hopper queues)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (queue) (hopper_queue_depth{state=\"ready\"})",
     "legendFormat": "{{queue}} ready"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Chunks ingested per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(sift_ingest_chunks_total[5m]))",
     "legendFormat": "chunks"
    }
   ]
  }
 ]
}
