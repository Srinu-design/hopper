# Scripts and config that run on Linux hosts and in containers keep LF line endings, even in a
# Windows checkout: bash and Caddy fail on CRLF.
*.sh text eol=lf
deploy/** text eol=lf
docker/** text eol=lf
# Images ship in deploy/site too: binary, so the rule above never converts their bytes.
*.webp binary
*.png binary
*.gif binary
